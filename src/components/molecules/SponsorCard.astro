---
import Icon from '@components/molecules/Icon.svelte';
---

<aside class="sponsor">
  <div>
    <h2>Enjoying Web Check?</h2>
    <p>
      It's free, open source and funded by the community. If it's been useful, sponsoring me on
      GitHub helps keep it running and ad-free.
    </p>
  </div>
  <a href="https://github.com/sponsors/Lissy93" target="_blank" rel="noreferrer">
    <Icon name="heart" size={0.9} />
    Sponsor on GitHub
  </a>
</aside>

<style lang="scss">
  .sponsor {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--primary-transparent);
    border-radius: 4px;
    background: var(--background);
    h2 {
      margin: 0 0 0.25rem;
      font-size: 1.2rem;
    }
    p {
      max-width: 60ch;
      margin: 0;
      line-height: 1.5;
      color: var(--text-color-secondary);
    }
    a {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 1rem;
      border-radius: 4px;
      background: var(--primary);
      color: var(--background);
      font-weight: 600;
      white-space: nowrap;
      transition: background 0.3s ease;
      &:hover,
      &:focus-visible {
        background: var(--text-color);
        text-decoration: none;
      }
    }
  }
</style>
